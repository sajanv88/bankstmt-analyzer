# Normalise to LF in the repository. Without this, a Windows checkout with
# core.autocrlf=true commits CRLF, which breaks the Makefile's recipes, the
# shell steps in the GitHub Actions workflows, and anything COPY'd into the
# Linux container image.
* text=auto eol=lf

# Generated by sqlc: excluded from language statistics and diffs, but still
# reviewed in CI via `sqlc diff`.
internal/db/db.go        linguist-generated=true
internal/db/models.go    linguist-generated=true
internal/db/querier.go   linguist-generated=true
internal/db/*.sql.go     linguist-generated=true
