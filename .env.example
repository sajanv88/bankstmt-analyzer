# Copy to .env and fill in the Azure values, then `make run`.

# --- required -------------------------------------------------------------
DATABASE_URL=postgres://bankstmt:bankstmt@localhost:5432/bankstmt?sslmode=disable

# Where uploaded PDFs go: "s3" (any S3-compatible store) or "local".
#
# Use s3 whenever the API and the worker are separate processes: the API
# writes an upload's PDFs and the worker reads them, so with "local" they
# must share a filesystem. `make compose-up` starts a MinIO for this.
STORAGE_BACKEND=s3

# --- required when STORAGE_BACKEND=s3 -------------------------------------
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=bankstmt-uploads
S3_ACCESS_KEY_ID=bankstmt
S3_SECRET_ACCESS_KEY=bankstmt123

# --- required when STORAGE_BACKEND=local ----------------------------------
STORAGE_DIR=./.data/uploads

AZURE_OCR_ENDPOINT=https://<your-ocr-resource>.services.ai.azure.com
AZURE_OCR_API_KEY=<ocr-api-key>
AZURE_OCR_MODEL=mistral-ocr-2503

AZURE_OPENAI_ENDPOINT=https://<your-openai-resource>.openai.azure.com
AZURE_OPENAI_API_KEY=<openai-api-key>
AZURE_OPENAI_DEPLOYMENT=<deployment-name>

# --- optional, shown with their defaults ----------------------------------
# Host port docker-compose publishes Postgres on. Change it (and the port in
# DATABASE_URL above) if 5432 is already in use on this machine.
POSTGRES_PORT=5432
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001

S3_REGION=us-east-1
# Path-style addressing: MinIO needs it, AWS S3 proper does not.
S3_USE_PATH_STYLE=true
# Optional key prefix, so one bucket can host several environments.
S3_PREFIX=
S3_TIMEOUT=2m

ENV=development
HTTP_ADDR=:8080
LOG_LEVEL=info
MIGRATE_ON_START=false

AZURE_OCR_TIMEOUT=5m
AZURE_OCR_PATH=/providers/mistral/azure/ocr
AZURE_OPENAI_TIMEOUT=10m
AZURE_OPENAI_API_VERSION=2024-10-21

HTTP_READ_HEADER_TIMEOUT=10s
HTTP_WRITE_TIMEOUT=2m
HTTP_IDLE_TIMEOUT=60s
HTTP_SHUTDOWN_TIMEOUT=20s
HTTP_CORS_ALLOWED_ORIGINS=*

WORKER_CONCURRENCY=4
WORKER_MAX_RETRY=3
WORKER_BACKOFF_BASE=2s
WORKER_BACKOFF_MAX=2m

TASKQ_QUEUE=bankstmt-analysis
TASKQ_LEASE_DURATION=15m
TASKQ_POLL_INTERVAL=1s

UPLOAD_MAX_FILES=12
UPLOAD_MAX_FILE_BYTES=20971520
